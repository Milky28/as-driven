{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://as-driven.example/schema/v1/curation-approval.schema.json",
  "title": "As Driven per-car curation approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_version",
    "approved_at",
    "record_id",
    "simulator",
    "telemetry_name",
    "observed_game_version",
    "observed_through",
    "approved_controls",
    "confidence_notes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "dataset_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "approved_at": {
      "type": "string",
      "format": "date"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "simulator": {
      "enum": [
        "ams2",
        "iracing",
        "ac",
        "acc",
        "ac-evo",
        "ac-rally",
        "raceroom",
        "rf2",
        "other"
      ]
    },
    "telemetry_name": {
      "type": "string",
      "minLength": 1
    },
    "additional_telemetry_names": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "basis"
        ],
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "telemetry_class": {
      "type": "string",
      "minLength": 1,
      "description": "The simulator's own class token for the car, when it has one. Omitted for a simulator that does not group its cars - Assetto Corsa EVO reports no class at all - because there is nothing to approve rather than an unknown value."
    },
    "additional_telemetry_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observed_game_version": {
      "type": "string",
      "minLength": 1,
      "not": {
        "const": "latest"
      }
    },
    "observed_through": {
      "type": "string",
      "minLength": 1
    },
    "approved_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forward_gears",
        "shift_actuation",
        "standing_start_clutch",
        "automatic_cut",
        "automatic_blip",
        "wheel_rim_shape"
      ],
      "properties": {
        "forward_gears": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 20
        },
        "shift_actuation": {
          "type": "string",
          "enum": [
            "h-pattern",
            "sequential-stick",
            "sequential-paddles",
            "automatic-lever",
            "direct-selection",
            "unknown"
          ]
        },
        "shift_pattern": {
          "type": "string",
          "enum": [
            "standard-h",
            "dogleg-h",
            "sequential",
            "automatic-gate",
            "direct",
            "unknown"
          ]
        },
        "standing_start_clutch": {
          "type": "string",
          "enum": [
            "required",
            "not-required",
            "anti-stall-available",
            "unknown",
            "not-applicable"
          ]
        },
        "running_shift_clutch": {
          "description": "Single summary of the clutch requirement for running shifts. Optional: it is omitted when the upshift and downshift clutch requirements differ, because one value cannot summarize them.",
          "type": "string",
          "enum": [
            "required",
            "not-required",
            "optional",
            "unknown",
            "not-applicable"
          ]
        },
        "throttle_lift": {
          "type": "string",
          "enum": [
            "required",
            "not-required",
            "partial",
            "unknown",
            "not-applicable"
          ]
        },
        "automatic_cut": {
          "$ref": "#/$defs/state"
        },
        "automatic_blip": {
          "$ref": "#/$defs/state"
        },
        "manual_blip": {
          "type": "string",
          "enum": [
            "required",
            "not-required",
            "optional",
            "unknown",
            "not-applicable"
          ]
        },
        "wheel_rim_shape": {
          "description": "Approved rim shape, matching the record's simulator behavior. gt-style, prototype and formula are retired into gt-formula and remain accepted only so existing approvals stay valid.",
          "type": "string",
          "enum": [
            "round",
            "d-shaped",
            "gt-formula",
            "gt-style",
            "prototype",
            "formula",
            "yoke",
            "other",
            "unknown"
          ]
        },
        "wheel_integrated_display": {
          "$ref": "#/$defs/state"
        },
        "wheel_shift_lights": {
          "$ref": "#/$defs/state"
        },
        "wheel_open_top": {
          "$ref": "#/$defs/state"
        }
      }
    },
    "confidence_notes": {
      "type": "string",
      "minLength": 1
    },
    "scope_notes": {
      "type": "string"
    },
    "historical_notes": {
      "type": "string"
    },
    "game_version_correction": {
      "description": "A reviewed correction when the immutable guided-drive draft could not detect an exact simulator build. The approval keeps both what the draft recorded and the separately verified exact build; prose alone never changes the version.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed",
        "verified",
        "basis"
      ],
      "properties": {
        "observed": {
          "const": "unknown"
        },
        "verified": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": [
              "unknown",
              "latest"
            ]
          }
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "correction_history": {
      "description": "Reviewed replacement history for an incorrect simulator observation. The current approval describes the replacement drive; each history item preserves exactly which prior source and user-facing facts it superseded.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "corrected_at",
          "superseded_source_ref",
          "replacement_source_ref",
          "basis",
          "behavior_changes",
          "authentic_control_changes",
          "removed_simulator_overrides"
        ],
        "properties": {
          "corrected_at": {
            "type": "string",
            "format": "date"
          },
          "superseded_source_ref": {
            "type": "string",
            "minLength": 1
          },
          "replacement_source_ref": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "behavior_changes": {
            "$ref": "#/$defs/correctionChanges"
          },
          "authentic_control_changes": {
            "$ref": "#/$defs/correctionChanges"
          },
          "removed_simulator_overrides": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "simulator",
                "path",
                "value",
                "basis"
              ],
              "properties": {
                "simulator": {
                  "enum": [
                    "ams2",
                    "iracing",
                    "ac",
                    "acc",
                    "ac-evo",
                    "ac-rally",
        "raceroom",
        "rf2",
                    "other"
                  ]
                },
                "path": {
                  "type": "string",
                  "pattern": "^/authentic_controls/"
                },
                "value": {},
                "basis": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "staged_record_id": {
      "type": "string",
      "minLength": 1,
      "description": "The record id the bundle derived from the simulator's own name for the car, when the reviewer promoted it under a different one. A record id names the real car, and a simulator with a mod ecosystem reports whatever an author typed - so a rename is an identity decision, and this keeps what it was renamed from visible in the approval that authorised it."
    }
  },
  "$defs": {
    "correctionChanges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "from",
          "to"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "from": {},
          "to": {},
          "basis": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "unknown",
        "not-applicable"
      ]
    }
  }
}
