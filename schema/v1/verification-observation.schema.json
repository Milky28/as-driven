{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:as-driven:schema:v1:verification-observation",
  "title": "As Driven staged simulator verification observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "simulator",
    "game_version",
    "observed_at",
    "observer",
    "identity",
    "assists",
    "tests",
    "cockpit",
    "review_status"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "observation_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "simulator": {
      "type": "string",
      "enum": [
        "ams2",
        "iracing",
        "ac-evo",
        "ac-rally",
        "other"
      ]
    },
    "game_version": {
      "type": "string",
      "minLength": 1,
      "not": {
        "const": "latest"
      }
    },
    "client_version": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "observer": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "telemetry_name",
        "telemetry_class"
      ],
      "properties": {
        "telemetry_name": {
          "type": "string",
          "minLength": 1
        },
        "telemetry_class": {
          "type": "string",
          "minLength": 1
        },
        "internal_id": {
          "type": "string"
        }
      }
    },
    "assists": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automatic_clutch",
        "automatic_shifting",
        "automatic_throttle_blip"
      ],
      "properties": {
        "automatic_clutch": {
          "$ref": "#/$defs/assistState"
        },
        "automatic_shifting": {
          "$ref": "#/$defs/assistState"
        },
        "automatic_throttle_blip": {
          "$ref": "#/$defs/assistState"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "move_off_without_physical_clutch",
        "forward_gears",
        "clutchless_upshift",
        "automatic_cut",
        "clutchless_downshift",
        "automatic_blip"
      ],
      "properties": {
        "move_off_without_physical_clutch": {
          "$ref": "#/$defs/observedState"
        },
        "forward_gears": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 20
        },
        "direct_gear_selection_behavior": {
          "$ref": "#/$defs/directSelectionState"
        },
        "clutchless_upshift": {
          "$ref": "#/$defs/observedState"
        },
        "automatic_cut": {
          "$ref": "#/$defs/observedState"
        },
        "automatic_cut_method": {
          "type": "string"
        },
        "clutchless_downshift": {
          "$ref": "#/$defs/observedState"
        },
        "automatic_blip": {
          "$ref": "#/$defs/observedState"
        },
        "automatic_blip_method": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "cockpit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visible_shift_actuators",
        "primary_shift_actuation",
        "wheel_rim"
      ],
      "properties": {
        "visible_shift_actuators": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "paddles",
              "sequential-stick",
              "h-pattern",
              "automatic-lever",
              "unknown"
            ]
          }
        },
        "primary_shift_actuation": {
          "type": "string",
          "enum": [
            "h-pattern",
            "sequential-stick",
            "sequential-paddles",
            "automatic-lever",
            "direct-selection",
            "unknown"
          ]
        },
        "actuation_basis": {
          "type": "string"
        },
        "shift_pattern": {
          "description": "Gate pattern seen in the cockpit. A dogleg layout puts first gear down-left and changes how the car is driven, so it is recorded when visible rather than inferred from the mechanism.",
          "type": "string",
          "enum": [
            "standard-h",
            "dogleg-h",
            "sequential",
            "automatic-gate",
            "direct",
            "unknown"
          ]
        },
        "wheel_rim": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shape",
            "integrated_display",
            "shift_lights",
            "open_top"
          ],
          "properties": {
            "shape": {
              "description": "Rim shape, decided by the rim itself; the car's racing class never enters into it. First decide how the hands use it: a control-panel rim has molded grips at about 9 and 3 with a control face between them and the hands stay put, while a conventional rim is a continuous band you can grip anywhere. Then take the first that matches: yoke (two separate grips with nothing connecting them), formula (a control-panel rim open across the top, with no material joining the grips over the top), gt-style (a control-panel rim with a closed perimeter, usually flattened top and bottom), d-shaped (a conventional rim flattened at the bottom, the top, or both), round (a conventional continuous circle). A closed perimeter is not a grippable one: a GT rim has the same molded grips a formula rim has, and only the material over the top separates them. Use other when none match and unknown when the rim was not seen. prototype is deprecated: it named a racing category rather than a rim and covered the same closed control-panel form as gt-style. It stays in the enum so existing records remain valid, but must not be used for new records.",
              "type": "string",
              "enum": [
                "round",
                "d-shaped",
                "gt-style",
                "prototype",
                "formula",
                "yoke",
                "other",
                "unknown"
              ]
            },
            "integrated_display": {
              "description": "Whether the rim itself carries a readout: a graphical LCD, an LED numeric gear indicator, or a segment display all count. A dash mounted on the car rather than the rim does not, and shift lights alone do not.",
              "$ref": "#/$defs/observedState"
            },
            "shift_lights": {
              "description": "Whether the rim carries shift or rev lights, recorded independently of integrated_display.",
              "$ref": "#/$defs/observedState"
            },
            "open_top": {
              "description": "Whether rim material joins the grips over the top of the rim. It asks about material, not about where the rim is held: a formula rim is yes, a yoke is always yes, and a gt-style, d-shaped or round rim is no.",
              "$ref": "#/$defs/observedState"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_status": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed",
        "approved",
        "rejected"
      ]
    },
    "reviewer": {
      "type": "string"
    }
  },
  "$defs": {
    "observedState": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "unknown",
        "not-tested"
      ]
    },
    "directSelectionState": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "unknown",
        "not-tested",
        "not-applicable"
      ]
    },
    "assistState": {
      "type": "string",
      "enum": [
        "enabled",
        "disabled",
        "unavailable",
        "unknown"
      ]
    }
  }
}
