{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:as-driven:schema:v1:verification-observation",
  "title": "As Driven staged simulator verification observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "simulator",
    "game_version",
    "observed_at",
    "observer",
    "identity",
    "assists",
    "tests",
    "cockpit",
    "review_status"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "observation_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "simulator": {
      "type": "string",
      "enum": [
        "ams2",
        "iracing",
        "ac-evo",
        "ac-rally",
        "other"
      ]
    },
    "game_version": {
      "type": "string",
      "minLength": 1,
      "not": {
        "const": "latest"
      }
    },
    "client_version": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "observer": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "telemetry_name",
        "telemetry_class"
      ],
      "properties": {
        "telemetry_name": {
          "type": "string",
          "minLength": 1
        },
        "telemetry_class": {
          "type": "string",
          "minLength": 1
        },
        "internal_id": {
          "type": "string"
        }
      }
    },
    "assists": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automatic_clutch",
        "automatic_shifting",
        "automatic_throttle_blip"
      ],
      "properties": {
        "automatic_clutch": {
          "$ref": "#/$defs/assistState"
        },
        "automatic_shifting": {
          "$ref": "#/$defs/assistState"
        },
        "automatic_throttle_blip": {
          "$ref": "#/$defs/assistState"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "move_off_without_physical_clutch",
        "forward_gears",
        "clutchless_upshift",
        "automatic_cut",
        "clutchless_downshift",
        "automatic_blip"
      ],
      "properties": {
        "move_off_without_physical_clutch": {
          "$ref": "#/$defs/observedState"
        },
        "forward_gears": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 20
        },
        "direct_gear_selection_behavior": {
          "$ref": "#/$defs/directSelectionState"
        },
        "clutchless_upshift": {
          "$ref": "#/$defs/observedState"
        },
        "automatic_cut": {
          "$ref": "#/$defs/observedState"
        },
        "automatic_cut_method": {
          "type": "string"
        },
        "clutchless_downshift": {
          "$ref": "#/$defs/observedState"
        },
        "automatic_blip": {
          "$ref": "#/$defs/observedState"
        },
        "automatic_blip_method": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "cockpit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visible_shift_actuators",
        "primary_shift_actuation",
        "wheel_rim"
      ],
      "properties": {
        "visible_shift_actuators": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "paddles",
              "sequential-stick",
              "h-pattern",
              "automatic-lever",
              "unknown"
            ]
          }
        },
        "primary_shift_actuation": {
          "type": "string",
          "enum": [
            "h-pattern",
            "sequential-stick",
            "sequential-paddles",
            "automatic-lever",
            "direct-selection",
            "unknown"
          ]
        },
        "actuation_basis": {
          "type": "string"
        },
        "shift_pattern": {
          "description": "Gate pattern seen in the cockpit. A dogleg layout puts first gear down-left and changes how the car is driven, so it is recorded when visible rather than inferred from the mechanism.",
          "type": "string",
          "enum": [
            "standard-h",
            "dogleg-h",
            "sequential",
            "automatic-gate",
            "direct",
            "unknown"
          ]
        },
        "wheel_rim": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shape",
            "integrated_display",
            "shift_lights",
            "open_top"
          ],
          "properties": {
            "shape": {
              "description": "Rim shape, decided by the rim itself; the car's racing class never enters into it. Take the first that matches: gt-formula (molded grips at about 9 and 3 with a control face between them, so the hands stay put - the rim modern GT, formula and prototype cars all share, usually carrying a display and rev lights), yoke (two grips with nothing joining them over the top), d-shaped (a conventional rim you can grip anywhere, flattened at the bottom, the top, or both), round (a conventional continuous circle). Use other when none match and unknown when the rim was not seen. gt-style, formula and prototype are deprecated: they split one rim three ways by racing class, produced the same client icon, and asked reviewers for a judgment that changed no advice. They stay in the enum so existing records remain valid, but must not be used for new records.",
              "type": "string",
              "enum": [
                "round",
                "d-shaped",
                "gt-formula",
                "gt-style",
                "prototype",
                "formula",
                "yoke",
                "other",
                "unknown"
              ]
            },
            "integrated_display": {
              "description": "Whether the rim itself carries a readout: a graphical LCD, an LED numeric gear indicator, or a segment display all count. A dash mounted on the car rather than the rim does not, and shift lights alone do not.",
              "$ref": "#/$defs/observedState"
            },
            "shift_lights": {
              "description": "Whether the rim carries shift or rev lights, recorded independently of integrated_display.",
              "$ref": "#/$defs/observedState"
            },
            "open_top": {
              "description": "Whether rim material joins the grips over the top of the rim. It asks about material, not about where the rim is held, and it describes the rim rather than deciding its shape: a gt-formula rim may be either, a yoke is always yes, and a d-shaped or round rim is no.",
              "$ref": "#/$defs/observedState"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_status": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed",
        "approved",
        "rejected"
      ]
    },
    "reviewer": {
      "type": "string"
    }
  },
  "$defs": {
    "observedState": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "unknown",
        "not-tested"
      ]
    },
    "directSelectionState": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "unknown",
        "not-tested",
        "not-applicable"
      ]
    },
    "assistState": {
      "type": "string",
      "enum": [
        "enabled",
        "disabled",
        "unavailable",
        "unknown"
      ]
    }
  }
}
